# Copy this file to .env and fill in your credentials

# Optional: CRIC API key for live match data
CRIC_API_KEY=

# Google ADK / Google Cloud credentials
# Option A: Path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Option B: If using API key (less common for ADK), set this
GOOGLE_API_KEY=

# ADK-specific settings (optional)
ADK_PROJECT_ID=
ADK_REGION=us-central1

# Any other env vars used by the app

